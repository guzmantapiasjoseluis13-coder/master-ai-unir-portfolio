import os
import sys
import streamlit as st

st.set_page_config(
    page_title="Buscador Semántico | Enterprise AI",
    page_icon="🔍",
    layout="wide",
)

st.markdown(
    """
    <style>
        .block-container {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }
        .enterprise-header {
            background: linear-gradient(
                135deg, #0f172a 0%, #1e293b 100%
            );
            padding: 2rem;
            border-radius: 12px;
            border: 1px solid #334155;
            color: #f8fafc;
            margin-bottom: 2rem;
        }
    </style>
    """,
    unsafe_allow_html=True,
)

current_dir = os.path.dirname(os.path.abspath(__file__))
src_dir = os.path.abspath(os.path.join(current_dir, "../src"))
if src_dir not in sys.path:
    sys.path.insert(0, src_dir)

try:
    import semantic_search as sem_mod  # type: ignore # noqa: E402
except ImportError:
    sem_mod = None


@st.cache_data
def cargar_corpus_desde_archivo():
    """Lee dinámicamente el archivo local y separa texto y URL."""
    possible_paths = [
        os.path.join(current_dir, "../data/raw/oferta_medellin.txt"),
        os.path.join(current_dir, "../data/oferta_medellin.txt"),
        os.path.join(current_dir, "../../data/raw/oferta_medellin.txt"),
        "oferta_medellin.txt",
    ]
    for path in possible_paths:
        if os.path.exists(path):
            with open(path, "r", encoding="utf-8") as f:
                lines = f.readlines()
                parsed_data = []
                for line in lines:
                    if line.strip():
                        parts = line.strip().split("|")
                        texto = parts[0].strip()
                        if len(parts) > 1:
                            url = parts[1].strip()
                        else:
                            q_enc = texto.replace(" ", "+")
                            url = "https://www.google.com/" + f"search?q={q_enc}"
                        parsed_data.append(
                            {
                                "texto": texto,
                                "url": url,
                            }
                        )
                return parsed_data
    return []


corpus_local = cargar_corpus_desde_archivo()

with st.sidebar:
    st.markdown("### ⚙️ Configuración IR")
    blog_help_msg = (
        "Extrae artículos en " + "tiempo real de " + "sena-comercio.blogspot.com"
    )
    incluir_blog = st.checkbox(
        "Incluir Blog Centro de Comercio",
        value=True,
        help=blog_help_msg,
    )
    top_k = st.slider(
        "Resultados Top-K",
        min_value=1,
        max_value=5,
        value=3,
    )
    st.markdown("---")
    st.info(
        "**Motor Vectorial Activo**\n\n"
        + "Combinando corpus local institucional "
        + "y entradas web del blog SENA."
    )


@st.cache_resource
def obtener_buscador(model_name="all-MiniLM-L6-v2"):
    """Instancia el motor vectorial."""
    if sem_mod and hasattr(sem_mod, "BuscadorVectorial"):
        return sem_mod.BuscadorVectorial(model_name=model_name)
    return None


buscador = obtener_buscador()

if buscador and hasattr(buscador, "indexar_corpus"):
    buscador.indexar_corpus(
        corpus_local=corpus_local,
        incluir_blog=incluir_blog,
    )

st.markdown(
    """
    <div class="enterprise-header">
        <h2>🔍 Módulo Enterprise: Buscador Vectorial</h2>
        <p style="color: #94a3b8; margin: 0;">
            Cátedra PLN: Recuperación de información
            con espacios vectoriales y Coseno.
        </p>
    </div>
    """,
    unsafe_allow_html=True,
)

tab1, tab2, tab3 = st.tabs(
    [
        "💬 Consulta Semántica",
        "📊 Espacio Vectorial 2D",
        "⚙️ Arquitectura & Métricas",
    ]
)

with tab1:
    with st.container(border=True):
        st.markdown("### 🔎 Ingrese su consulta semántica:")
        ph_text = (
            "Ej: tecnología, "
            + "inscripciones, "
            + "contrato de "
            + "aprendizaje, CDMC..."
        )
        query = st.text_input(
            "Consulta",
            placeholder=ph_text,
            label_visibility="collapsed",
        )

        if not query:
            st.info(
                "👋 **Bienvenido al motor de recuperación (IR).**\n"
                + "Ingrese un término clave o concepto "
                + "institucional para consultar similitudes."
            )
        else:
            if not buscador or not hasattr(buscador, "buscar"):
                err_msg = (
                    "⚠️ El motor backend " + "no está disponible\n" + "o incompleto."
                )
                st.warning(err_msg)
            else:
                res_tuple = buscador.buscar(query, top_k=top_k)
                resultados, q_2d, score_prom = res_tuple

                if resultados:
                    msg_ex = (
                        "✅ **Búsqueda Exitosa** " + f"(Promedio: {score_prom:.4f})"
                    )
                    st.success(msg_ex)

                    for i, res in enumerate(resultados, 1):
                        score_val = res["score"]
                        texto_res = res["texto"]
                        url_res = res["url"]

                        with st.container(border=True):
                            prefix_score = (
                                f"**{i}. "
                                + "[Similitud Coseno: "
                                + f"{score_val:.4f}]**"
                            )
                            st.markdown(prefix_score)
                            st.write(texto_res)
                            link_txt = (
                                "🔗 **[Sitio Oficial / " + f"Fuente]**({url_res})"
                            )
                            st.markdown(link_txt)
                else:
                    msg_w = "⚠️ No se encontraron " + f"resultados para\n'{query}'."
                    st.warning(msg_w)

with tab2:
    with st.container(border=True):
        st.markdown("### 📈 Proyección Bidimensional (PCA 2D)")
        st.write(
            "Visualización de los embeddings proyectados "
            + "a 2D para el corpus indexado y la consulta."
        )

        if (
            buscador
            and hasattr(buscador, "corpus_2d")
            and buscador.corpus_2d is not None
            and len(buscador.corpus_2d) > 0
        ):
            import pandas as pd

            corpus_points = buscador.corpus_2d
            df_plot = pd.DataFrame(
                corpus_points,
                columns=["PCA_1", "PCA_2"],
            )
            tipo_list = ["Documento / Blog" for _ in range(len(corpus_points))]
            df_plot["Tipo"] = tipo_list

            st.scatter_chart(
                df_plot,
                x="PCA_1",
                y="PCA_2",
                color="Tipo",
                use_container_width=True,
            )
            info_txt = (
                "Total de vectores indexados en " + f"el espacio: {len(corpus_points)}"
            )
            st.info(info_txt)
        else:
            plan_msg = (
                "Indexe el corpus para " + "visualizar el plano\n" + "bidimensional."
            )
            st.info(plan_msg)

with tab3:
    with st.container(border=True):
        st.markdown("### 📐 Especificaciones Matemáticas")
        st.write(
            "- **Modelo Base:** Sentence-Transformers "
            + "(`all-MiniLM-L6-v2`, 384 dim).\n"
            + "- **Métrica:** Similitud del Coseno.\n"
            + "- **Ingesta Híbrida:** Corpus local + "
            + "Web Scraping del blog SENA "
            + "(`https://sena-comercio.blogspot.com/`).\n"
            + "- **Reducción Dimensional:** PCA (2D)."
        )
